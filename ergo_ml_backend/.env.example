# Copy this to .env and fill in your values

# Every setting here is listed in README.md -> "Environment variables".

# Database — SQLite by default. Postgres also works with a driver installed
# (pip install psycopg2-binary):
DATABASE_URL=sqlite:///./ergocare.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ergocare

# Directory where audio uploads are stored
AUDIO_UPLOAD_DIR=./uploads/audio

# ── Web app origins allowed to call the API (CORS) ───────────────────────────
# Leave unset locally (localhost:5173 / :4173 / :8000 are allowed). REQUIRED in
# production - the server refuses to start on Render without it. "*" is refused.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Audio upload limits ───────────────────────────────────────────────────────
MAX_AUDIO_MB=10       # Maximum size per audio clip in MB (default: 10)
MIN_FREE_MB=500       # Minimum free disk space required to accept uploads (default: 500)

# ── Admin login (server-side; never put these in index.html) ─────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Signs login tokens. Set a long random value so logins survive restarts.
ADMIN_SECRET=change-me-to-64-random-characters
# Optional static token for scripts (X-Admin-Token header). Leave unset to disable.
# ADMIN_API_TOKEN=
# Optional: store a PBKDF2 hash instead of the plain password (takes precedence).
# Format: pbkdf2_sha256$<iterations>$<salt_hex>$<hash_hex>
# ADMIN_PASSWORD_HASH=
# Hours an admin login stays valid (default 8)
# ADMIN_TOKEN_HOURS=8

# ── Wearable (device) authentication ──────────────────────────────────────────
# Shared secret the ESP32 / usb_bridge / demo_simulator must send as
# X-Device-Token to POST /api/devices/{device_id}/readings.
#
# While this is empty the ingest endpoint is OPEN, which lets anyone who knows a
# device id inject heart rate, skin response and tilt values. Those values become
# the participant's baseline and the 40% body-signal half of their ErgoCare Index,
# so this is a direct path to falsifying a health report.
#
# Generate one and paste it into BOTH this file and
# firmware/ergocare_wearable/secrets.h (DEVICE_TOKEN):
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_INGEST_TOKEN=

# ── Sensor data retention ─────────────────────────────────────────────────────
# Readings older than this are deleted (seconds). Default 6 hours, which covers
# the 60 s baseline plus a full assessment. Set to 0 to keep everything.
SENSOR_RETENTION_S=21600

# ── AI answer matcher (optional) ──────────────────────────────────────────────
# Sentence-embedding model (downloaded once, ~90 MB) and where it is cached.
# MATCHER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MATCHER_CACHE_DIR=./models_cache
