# Web app settings (read by Vite). Copy to .env in this folder.
# Backend settings live in ergo_ml_backend/.env.example - not here.

# URL of the FastAPI backend. Leave unset locally (defaults to http://127.0.0.1:8000).
# On Vercel set it under Settings -> Environment Variables, e.g.:
# VITE_API_BASE=https://ergocare-backend.onrender.com
